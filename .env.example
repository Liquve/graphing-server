# Скопируйте этот файл в .env и поменяйте значения при необходимости.

# TCP-порт сервера на вашем компьютере.
SERVER_PORT=13579

# PostgreSQL будет доступен с вашего компьютера на этом порту.
POSTGRES_PORT=5432

# Суперпользователь внутри контейнера PostgreSQL.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_password

# Отдельная база и пользователь приложения.
APP_DB_NAME=calc_db
APP_DB_USER=calc_app
APP_DB_PASSWORD=calc_app_password

# Для локального PostgreSQL в Docker SSL выключен.
# Для внешней managed-БД обычно ставят require, verify-ca или verify-full.
DB_SSLMODE=disable

# Почтовый сервис не запускается этим compose-файлом.
# Укажите URL уже существующего сервиса, который принимает POST /message.
MAIL_SERVICE_BASE_URL=https://mail.liquve.space
MAIL_SERVICE_FROM_USER=admin
MAIL_SERVICE_SENDER_ALIAS=Graphing Server

# Количество точек при расчёте графика.
GRAPHING_CALCULATION_POINTS=1000
